    "warning.peak" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Peak 1600 nits — the panel runs hotter and uses more power." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Pico de 1600 nits: el panel se calienta más y consume más energía." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Пик 1600 нит — панель греется сильнее и больше сажает батарею." } },
