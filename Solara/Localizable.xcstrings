      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Move Solara Display to Applications" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Mueve Solara Display a Aplicaciones" } },
