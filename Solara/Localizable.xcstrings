        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关于" } }
      }
    },
    "about.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Solara Display unlocks MacBook Pro brightness up to 1600 nits." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Solara Display desbloquea el brillo del MacBook Pro hasta 1600 nits." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Solara Display разблокирует яркость MacBook Pro до 1600 нит." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Solara Display 可将 MacBook Pro 的亮度解锁至 1600 尼特。" } }
      }
    },
    "about.requires" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS 14 or later. 1600 nits on 2021+ 14\"/16\" MacBook Pro." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "macOS 14 o posterior. 1600 nits en MacBook Pro de 14\"/16\" de 2021 o posterior." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "macOS 14 и новее. 1600 нит — 14\"/16\" MacBook Pro 2021+." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要 macOS 14 或更高版本。1600 尼特适用于 2021 年及之后的 14\"/16\" MacBook Pro。" } }
      }
    },
