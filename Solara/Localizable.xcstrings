      }
    },
    "install.move_body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag the app into Applications, then open it from there. Running from a disk image can break brightness control." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Arrastra la app a Aplicaciones y ábrela desde ahí. Si se ejecuta desde una imagen de disco, el control de brillo puede fallar." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Перетащите приложение в Программы и запускайте оттуда. С диска-образа управление яркостью может не работать." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将应用拖到“应用程序”文件夹，再从那里打开。从磁盘映像运行可能导致亮度控制失效。" } }
      }
